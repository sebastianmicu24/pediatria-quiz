# ──────────────────────────────────────────────────────────────
#  Quiz Pediatria — variabili d'ambiente
#  Copia questo file in .env.local e compila i valori.
#  Su Vercel: aggiungile in Project → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# ── Supabase ──
# Nel dashboard Supabase: pulsante "Connect" (in alto) oppure
# impostazioni (⚙) → "API Keys". Vedi docs/SETUP.md § 1.5.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chiave PUBBLICA, sicura nel browser: "Publishable key" (sb_publishable_...).
# È accettata anche la legacy "anon" key (JWT che inizia con eyJ..., in dismissione).
# Il progetto accetta anche il nome NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Chiave SEGRETA, usata solo lato server (export/eliminazione account):
# "Secret key" (sb_secret_...). È accettata anche la legacy "service_role" (JWT eyJ...).
# ⚠️ Non esporla mai al client e non committarla. Il progetto accetta
#    anche il nome SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Sito ──
# URL pubblico del sito (senza slash finale). In locale: http://localhost:3000.
# Su Vercel: il dominio assegnato, es. https://pediatria-quiz.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Titolare del trattamento (usato nelle pagine legali) ──
NEXT_PUBLIC_LEGAL_OWNER=Cristian Sebastian Micu
NEXT_PUBLIC_LEGAL_EMAIL=contact@sebastianmicu.com

# ── (Opzionale) indirizzo del titolare per la Privacy Policy ──
# NEXT_PUBLIC_LEGAL_ADDRESS=
